# ============================================================
# YYC³ IDE 环境变量样例 — 复制为 .env.local 后按需填写
# ⚠️ VITE_ 前缀变量会打进客户端 bundle：切勿放置任何私密长期密钥
# ============================================================

# ── 协作服务（y-websocket 兼容服务端，见 collab-server/README.md）──
# 本地开发默认 ws://localhost:1234；生产用 wss:// 域名
VITE_COLLAB_SERVER_URL=ws://localhost:1234
VITE_COLLAB_ROOM=yyc3-default
VITE_COLLAB_USER_NAME=本机开发者

# ── 终端沙箱（批③决策二；未配置 = dry-run 本地干跑）──
# 可选值：e2b | cloudflare | dry-run
VITE_SANDBOX_PROVIDER=dry-run
# 供应商密钥仅运行时透传 SDK、不落盘 localStorage；仍会进入 bundle，
# 生产环境应改由服务端代理保管（审计 H2 决策）
# VITE_E2B_API_KEY=
# VITE_CF_SANDBOX_API_KEY=
